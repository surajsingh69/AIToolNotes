<!-- Paste inside Blogger Theme -> Edit HTML right before </head> -->
<b:if cond='data:view.isPost'>
  <meta expr:content='data:post.snippet' name='description'/>
  <meta expr:content='data:post.title' property='og:title'/>
  <meta expr:content='data:post.snippet' property='og:description'/>
  <meta expr:content='data:post.url.canonical' property='og:url'/>
  <meta content='article' property='og:type'/>
  <script type='application/ld+json'>
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "headline": "<data:post.title.jsonEscaped/>",
    "datePublished": "<data:post.timestampISO8601/>",
    "dateModified": "<data:post.lastUpdatedISO8601/>",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "<data:post.url.canonical/>"
    },
    "author": {
      "@type": "Organization",
      "name": "AIToolNotes Editorial Team"
    },
    "publisher": {
      "@type": "Organization",
      "name": "AIToolNotes"
    }
  }
  </script>
</b:if>
